# Host-specific values belong in the deployed EnvironmentFile
# (/etc/homelab-arcade/homelab-arcade.env), not in the unit file.
#
# PORTAL_PORT is normally auto-resolved from ../homelab-infra/registry.yaml
# by scripts/up.sh — only set it here to override that lookup.
# PORTAL_PORT=20032

# Optional overrides, see scripts/up.sh:
# HOMELAB_ARCADE_PYTHON_EXE=/usr/bin/python3
# HOMELAB_INFRA_PATH=/home/jake/git/github.com/jakestanley/homelab-infra
# HOMELAB_STANDARDS_PATH=/home/jake/git/github.com/jakestanley/homelab-standards
# SKIP_PREFLIGHT=1
