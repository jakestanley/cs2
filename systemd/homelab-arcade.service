[Unit]
Description=homelab-arcade portal
After=network.target

[Service]
Type=simple
User=jake
Group=jake
WorkingDirectory=/home/jake/git/github.com/jakestanley/homelab-arcade
EnvironmentFile=-/etc/homelab-arcade/homelab-arcade.env
ExecStart=/home/jake/git/github.com/jakestanley/homelab-arcade/scripts/up.sh
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
