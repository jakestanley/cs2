PORTAL_PORT=20032

# Telegram bot — create via @BotFather on Telegram, required.
BOT_TOKEN=<bot_token>

# Comma-separated Telegram user IDs allowed to run side-effecting commands
# (start_server/stop_server). Leave empty to deny everyone (fail closed) —
# /status stays open regardless. Find your own ID by messaging @userinfobot.
ALLOWED_USER_IDS=<your_telegram_user_id>[,<another_id>...]
